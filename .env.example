# Copy to .env and fill in. Both are optional.

# Require this password (any username) to open the UI. Scan scripts and scan uploads stay open
# so live USBs and OPNsense can post results. Empty = no login (LAN only).
RIGBOOK_PASSWORD=

# The address machines use to reach Rigbook, baked into the scan scripts so they can post back.
# Empty = whatever address you opened the UI on. Original deployment: http://192.168.1.216:8290
# (also proxied by Nginx Proxy Manager as http://inventory.jarvis/).
RIGBOOK_URL=
